<!doctype html>
<html lang="en">
  <head>
    {% set metaTitle = title if page.url == "/" else title ~ " | Hasbi" %}
    {% set metaDescription = description or site.description %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#f7f7f3">
    <title>{{ metaTitle }}</title>
    <meta name="description" content="{{ metaDescription }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ metaTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {% if isPost %}
      <meta property="article:published_time" content="{{ date | dateMachine }}">
      <meta name="twitter:card" content="summary">
    {% else %}
      <meta property="og:image" content="{{ site.url }}/og.png">
      <meta property="og:image:alt" content="Hasbi, Full-Stack Software Engineer">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:image" content="{{ site.url }}/og.png">
      <meta name="twitter:image:alt" content="Hasbi, Full-Stack Software Engineer">
    {% endif %}
    <meta name="twitter:title" content="{{ metaTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    <link rel="stylesheet" href="/assets/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Hasbi, home">Hasbi<span aria-hidden="true">.</span></a>
        <nav aria-label="Primary navigation">
          <ul class="nav-list">
            <li><a href="/"{% if navSection == "home" %} aria-current="page"{% endif %}>Profile</a></li>
            <li><a href="/blogs/"{% if navSection == "blogs" %} aria-current="page"{% endif %}>Blogs</a></li>
            <li>
              <a class="nav-cv" href="/output/pdf/hasbi-cv.pdf" target="_blank" rel="noopener">
                My CV<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>&copy; 2026 Hasbi. Built with care.</p>
        <nav class="footer-links" aria-label="Contact links">
          <a href="mailto:hasmbly@gmail.com">Email</a>
          <a href="https://github.com/hasmbly" rel="me">GitHub</a>
          <a href="https://www.linkedin.com/in/justhasby/" rel="me">LinkedIn</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
